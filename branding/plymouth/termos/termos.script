# TermOS boot splash (Plymouth script theme).
# Green 0/1 rain falls behind the TermOS logo, with a progress bar underneath.
# Images are generated by branding/make-art.py.

Window.SetBackgroundTopColor(0.008, 0.031, 0.016);
Window.SetBackgroundBottomColor(0.016, 0.086, 0.039);

W = Window.GetWidth();
H = Window.GetHeight();

CW = 16;      # glyph cell width
CH = 26;      # glyph cell height
TRAIL = 6;    # glyphs per falling trail (index 0 = bright head)

# Plymouth's Math.Random() can return 0 every time, so use our own
# Park-Miller generator. (Products stay below 2^53, so doubles are exact.)
rng_state = 20261105;
fun rand() {
  global.rng_state = (global.rng_state * 16807) % 2147483647;
  return global.rng_state / 2147483647;
}

for (g = 0; g < 2; g++)
  for (l = 0; l < TRAIL; l++)
    glyph[g * TRAIL + l] = Image("glyph-" + g + "-" + l + ".png");

fun random_glyph(level) {
  return glyph[Math.Int(rand() * 2) * TRAIL + level];
}

# ---- Rain -----------------------------------------------------------------

cols = Math.Int(W / CW / 2);
for (c = 0; c < cols; c++) {
  colx[c] = Math.Int(rand() * (W / CW)) * CW;
  coly[c] = rand() * H;
  speed[c] = 2 + rand() * 6;
  for (i = 0; i < TRAIL; i++) {
    rain[c * TRAIL + i] = Sprite(random_glyph(i));
    rain[c * TRAIL + i].SetPosition(colx[c], coly[c] - i * CH, -10);
  }
}

fun refresh_callback() {
  for (c = 0; c < global.cols; c++) {
    global.coly[c] += global.speed[c];
    if (global.coly[c] - global.TRAIL * global.CH > global.H) {
      global.coly[c] = -rand() * global.H / 2;
      global.colx[c] = Math.Int(rand() * (global.W / global.CW)) * global.CW;
      global.speed[c] = 2 + rand() * 6;
    }
    for (i = 0; i < global.TRAIL; i++) {
      s = global.rain[c * global.TRAIL + i];
      s.SetPosition(global.colx[c], global.coly[c] - i * global.CH, -10);
      if (rand() < 0.04)
        s.SetImage(random_glyph(i));
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Logo -----------------------------------------------------------------

shade.image = Image("shade.png");
shade.sprite = Sprite(shade.image);
shade.sprite.SetPosition(W / 2 - shade.image.GetWidth() / 2,
                         H / 2 - shade.image.GetHeight() / 2, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = W / 2 - logo.image.GetWidth() / 2;
logo.y = H / 2 - logo.image.GetHeight() / 2 - 20;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# ---- Progress bar ---------------------------------------------------------

bar.bg = Image("bar-bg.png");
bar.fg = Image("bar-fg.png");
bar.x = W / 2 - bar.bg.GetWidth() / 2;
bar.y = logo.y + logo.image.GetHeight() + 10;
bar.bg_sprite = Sprite(bar.bg);
bar.bg_sprite.SetPosition(bar.x, bar.y, 10);
bar.fg_sprite = Sprite();
bar.fg_sprite.SetPosition(bar.x, bar.y, 11);

fun progress_callback(duration, progress) {
  width = Math.Int(global.bar.fg.GetWidth() * progress);
  if (width < 1) width = 1;
  global.bar.fg_sprite.SetImage(global.bar.fg.Scale(width, global.bar.fg.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- Password prompt (encrypted disks) ------------------------------------

prompt.image = Image("prompt.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

fun show_password(prompt_text, bullets) {
  global.prompt.sprite = Sprite(global.prompt.image);
  global.entry.sprite = Sprite(global.entry.image);
  x = global.W / 2 - global.entry.image.GetWidth() / 2;
  y = global.bar.y + 30;
  global.prompt.sprite.SetPosition(x, y, 20);
  global.entry.sprite.SetPosition(x, y + 30, 20);
  for (i = 0; i < 24; i++)
    global.bullets[i] = NULL;
  for (i = 0; i < bullets && i < 24; i++) {
    global.bullets[i] = Sprite(global.bullet.image);
    global.bullets[i].SetPosition(x + 12 + i * 14, y + 30 + 16, 21);
  }
}
Plymouth.SetDisplayPasswordFunction(show_password);

fun show_normal() {
  global.prompt.sprite = NULL;
  global.entry.sprite = NULL;
  for (i = 0; i < 24; i++)
    global.bullets[i] = NULL;
}
Plymouth.SetDisplayNormalFunction(show_normal);

# ---- Messages -------------------------------------------------------------

fun show_message(text) {
  global.message.sprite = Sprite(Image.Text(text, 0.0, 1.0, 0.4));
  global.message.sprite.SetPosition(10, global.H - 30, 30);
}
Plymouth.SetMessageFunction(show_message);
