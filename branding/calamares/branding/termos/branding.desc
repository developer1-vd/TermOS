# TermOS branding for Calamares.
---
componentName:  termos

welcomeStyleCalamares:  false
welcomeExpandingLogo:   true

windowExpanding:    normal
windowSize:         1024px,640px
windowPlacement:    center

sidebar:    widget
navigation: widget

strings:
    productName:         TermOS
    shortProductName:    TermOS
    version:             "${VERSION_ID}"
    shortVersion:        "${VERSION_ID}"
    versionedName:       "TermOS ${VERSION_ID}"
    shortVersionedName:  "TermOS ${VERSION_ID}"
    bootloaderEntryName: TermOS
    productUrl:          https://github.com/developer1-vd/TermOS
    supportUrl:          https://github.com/developer1-vd/TermOS/issues
    knownIssuesUrl:      https://github.com/developer1-vd/TermOS/issues

images:
    productIcon:     "logo.png"
    productLogo:     "logo.png"
    productWelcome:  "welcome.png"

style:
    SidebarBackground:        "#020804"
    SidebarText:              "#00AA44"
    SidebarTextCurrent:       "#020804"
    SidebarBackgroundCurrent: "#00FF66"

slideshow:     "show.qml"
slideshowAPI:  2
