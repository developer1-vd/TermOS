#!/usr/bin/env bash
# termos-desktop: choose your desktop environment.
#
#   termos-desktop                 list the desktops, and which are installed
#   termos-desktop install NAME    install a desktop (asks for your password)
#   termos-desktop check NAME      only check that it can be installed
#   termos-desktop wallpaper       give the installed desktops the TermOS wallpaper
#
# NAME is one of: kde gnome xfce cinnamon mate lxqt lxde budgie cosmic sway i3
#
# TermOS comes with KDE Plasma. Installing another desktop adds it next to
# the ones you have: nothing is removed, and your login screen stays the
# same. To use it, log out and pick it from the session menu on the login
# screen; it remembers your choice.
#
# Desktops are Fedora's own package groups, installed with dnf, so this
# works on the PC and ARM editions (not on the phone edition).
set -euo pipefail

die() { echo "termos-desktop: $*" >&2; exit 1; }

# name | Fedora environment group | session files (in /usr/share/*sessions) | description
desktops() {
    cat <<'LIST'
kde|kde-desktop-environment|plasma*|KDE Plasma (TermOS's default)
gnome|workstation-product-environment|gnome*|GNOME
xfce|xfce-desktop-environment|xfce*|Xfce: light and classic
cinnamon|cinnamon-desktop-environment|cinnamon*|Cinnamon: traditional, from Linux Mint
mate|mate-desktop-environment|mate*|MATE: the classic GNOME 2 desktop
lxqt|lxqt-desktop-environment|lxqt*|LXQt: light, Qt-based
lxde|lxde-desktop-environment|LXDE*|LXDE: very light
budgie|budgie-desktop-environment|budgie*|Budgie
cosmic|cosmic-desktop-environment|cosmic*|COSMIC: System76's new desktop
sway|sway-desktop-environment|sway*|Sway: tiling, keyboard-driven (Wayland)
i3|i3-desktop-environment|i3*|i3: tiling, keyboard-driven (X11)
LIST
}

field() { desktops | awk -F'|' -v n="$1" -v f="$2" '$1 == n { print $f }'; }

installed() {
    local pattern f
    pattern="$(field "$1" 3)"
    for f in /usr/share/wayland-sessions/$pattern.desktop /usr/share/xsessions/$pattern.desktop; do
        [[ -e "$f" ]] && return 0
    done
    return 1
}

# dnf needs root, also to work out what an install would do.
as_root() {
    if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi
}

need_fedora() {
    command -v dnf >/dev/null || die "this needs dnf (the Fedora-based TermOS editions)"
}

list() {
    local name group pattern desc mark
    echo "Desktops (termos-desktop install NAME):"
    while IFS='|' read -r name group pattern desc; do
        mark=" "
        installed "$name" && mark="*"
        printf '  %s %-9s %s\n' "$mark" "$name" "$desc"
    done < <(desktops)
    echo "  * = installed. Running now: ${XDG_CURRENT_DESKTOP:-unknown}"
    echo "Switch at the login screen: log out, then pick a desktop from the session menu."
}

# The TermOS wallpaper as the default for the desktops that take their
# settings from dconf (GNOME, Budgie, Cinnamon, MATE). KDE has it already.
wallpaper() {
    local src=/usr/share/termos/desktops/50-termos-wallpaper
    command -v dconf >/dev/null || return 0
    [[ -f "$src" && -d /etc/dconf/db/local.d ]] || return 0
    as_root install -m 0644 "$src" /etc/dconf/db/local.d/50-termos-wallpaper
    as_root dconf update
}

install_desktop() {
    local name="$1" group
    group="$(field "$name" 2)"
    [[ -n "$group" ]] || die "unknown desktop '$name' (run termos-desktop for the list)"
    need_fedora
    if installed "$name"; then
        echo "termos-desktop: $name is already installed; pick it at the login screen."
        return 0
    fi
    echo "termos-desktop: installing $(field "$name" 4) (Fedora group $group)."
    echo "Nothing is removed. dnf shows what it will install and asks first."
    as_root dnf install "@^$group"
    wallpaper || echo "termos-desktop: couldn't set the TermOS wallpaper (the desktop is installed)"
    echo
    echo "termos-desktop: done. Log out, then pick '$name' from the session menu on the login screen."
}

# Resolve the install without doing it. dnf answers its own question with
# "no", which it reports as an aborted operation: that means it could be
# installed; a dependency problem is an error before that point.
check() {
    local name="$1" group out
    group="$(field "$name" 2)"
    [[ -n "$group" ]] || die "unknown desktop '$name' (run termos-desktop for the list)"
    need_fedora
    out="$(as_root env LC_ALL=C dnf install --assumeno "@^$group" 2>&1)" || true
    if grep -q "Operation aborted" <<<"$out" || grep -qi "nothing to do" <<<"$out"; then
        echo "termos-desktop: $name ($group) can be installed"
    else
        echo "$out" | tail -n 20 >&2
        die "$name ($group) can't be installed"
    fi
}

case "${1:-list}" in
    list)        list ;;
    install)     [[ -n "${2:-}" ]] || die "usage: termos-desktop install NAME"; install_desktop "$2" ;;
    check)       [[ -n "${2:-}" ]] || die "usage: termos-desktop check NAME"; check "$2" ;;
    wallpaper)   wallpaper; echo "termos-desktop: wallpaper set for new desktop sessions" ;;
    names)       desktops | cut -d'|' -f1 ;;
    -h|--help)   sed -n '2,17s/^# \{0,1\}//p' "$0" ;;
    *)           die "unknown command '$1' (see --help)" ;;
esac
